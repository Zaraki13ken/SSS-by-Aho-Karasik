# ==========================================
# Python
# ==========================================
# Байт-код и кэш интерпретатора
__pycache__/
*.py[cod]
*$py.class

# Файлы, создаваемые при сборке пакетов
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# Виртуальные окружения
# ==========================================
venv/
env/
.venv/
ENV/

# ==========================================
# IDE и редакторы
# ==========================================
# VS Code
.vscode/
# PyCharm / IntelliJ
.idea/
*.iml
# Vim
*.swp
*.swo
# Sublime Text
*.sublime-workspace
*.sublime-project

# ==========================================
# Инструменты тестирования и линтинга
# ==========================================
# Pylint
.pylint.d/
# Pytest
.pytest_cache/
# Coverage
.coverage
.coverage.*
htmlcov/

# ==========================================
# Операционные системы
# ==========================================
# Windows
Thumbs.db
Desktop.ini
# macOS
.DS_Store
# Linux
*~

# ==========================================
# Локальные файлы и настройки (не для репозитория)
# ==========================================
# Логи
*.log
# Файлы настроек среды
.env
.local
# Резервные копии
*.bak
*.tmp